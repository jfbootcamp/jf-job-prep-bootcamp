  <diagram id="u-uwq1gkVmdhfzV7PwIE" name="02_STEP -- 요구사항 분석">
    <mxGraphModel dx="1055" dy="601" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="DaWH2oN6KhjL7Vnl3aZd-1" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px; color: rgb(255, 255, 255);&quot;&gt;1&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="35" x="70" y="60" as="geometry" />
        </mxCell>
        <mxCell id="lm96Io0nbKgJCSDtATR3-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 26px;&quot;&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(204, 102, 0);&quot;&gt;STEP 1 -- 요구사항 분석 (Requirement Analysis)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="650" x="105" y="65" as="geometry" />
        </mxCell>
        <mxCell id="TrZsdiXPjQdw9zO7qV3g-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 15px; color: rgb(131, 131, 131);&quot;&gt;&quot;고객이 원하는 것&quot;을 정확히 파악하는 단계 -- 모든 설계의 출발점&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="530" x="148" y="100" as="geometry" />
        </mxCell>
        <mxCell id="TrZsdiXPjQdw9zO7qV3g-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;📖 요구 사항 문서 예시 : 온라인 도서관 시스템&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="450" y="140" as="geometry" />
        </mxCell>
        <mxCell id="TrZsdiXPjQdw9zO7qV3g-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="" vertex="1">
          <mxGeometry height="540" width="680" x="73" y="180" as="geometry" />
        </mxCell>
        <mxCell id="TrZsdiXPjQdw9zO7qV3g-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" value="&lt;font style=&quot;color: rgb(255, 255, 255); font-size: 17px;&quot;&gt;&lt;b&gt;온라인 도서관 시스템 -- 요구사항 명세서 (간략)&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="680" x="70" y="180" as="geometry" />
        </mxCell>
        <mxCell id="TrZsdiXPjQdw9zO7qV3g-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;&amp;nbsp;1. 업무 개요&lt;/b&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;도서관에서 &lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;회원&lt;/font&gt;&lt;/b&gt;이 &lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;도서&lt;/font&gt;&lt;/b&gt;를 &lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;&lt;b&gt;대출&lt;/b&gt;&lt;/font&gt;하고 &lt;b&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;반납&lt;/font&gt;&lt;/b&gt;하는 과정을 관리한다.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;&amp;nbsp;2. 상세 요구 사항&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;R1. &lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;회원&lt;/font&gt;&lt;/b&gt;은 &lt;u&gt;&lt;font style=&quot;color: rgb(0, 102, 51);&quot;&gt;이름, 이메일(고유), 전화번호, 주소&lt;/font&gt;&lt;/u&gt;를 가진다.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp;R2. &lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;도서&lt;/font&gt;&lt;/b&gt;는 &lt;font style=&quot;color: rgb(0, 102, 51);&quot;&gt;&lt;u&gt;ISBN(고유), 제목, 저자, 출판사, 출판연도, 분류, 보유수량&lt;/u&gt;&lt;/font&gt;을 가진다.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;R3. 한 명의 &lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;회원&lt;/font&gt;&lt;/b&gt;이 여러 권의 &lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;도서&lt;/font&gt;&lt;/b&gt;를 대출할 수 있다. (1:N)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;R4. 하나의 &lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;도서&lt;/font&gt;&lt;/b&gt;가 여러 번 &lt;b&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;대출&lt;/font&gt;&lt;/b&gt; 될 수 있다. (1: N)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;R5. &lt;b&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;대출 &lt;/font&gt;&lt;/b&gt;시 &lt;u&gt;&lt;font style=&quot;color: rgb(0, 102, 51);&quot;&gt;대출일, 반납예정일, 실제반납일, 상태&lt;/font&gt;&lt;/u&gt;를 기록한다.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;R6. 대출 &lt;u&gt;&lt;font style=&quot;color: rgb(0, 102, 51);&quot;&gt;상태&lt;/font&gt;&lt;/u&gt;는 &lt;font style=&quot;color: rgb(127, 0, 255);&quot;&gt;&quot;대출중&quot;, &quot;반납완료&quot;, &quot;연체&quot;&lt;/font&gt; 중 하나이다.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;3. 제약조건&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp;C1. 회원 이메일은 &lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;중복 불가&lt;/font&gt;&lt;/b&gt; --&amp;gt; UNIQUE 제약조건&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp;C2. 도서 보유수량은 &lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;0 이상&lt;/font&gt;&lt;/b&gt;이어야 한다. --&amp;gt; CHECK 제약조건&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp;C3. 회원/도서가 삭제되면 관련 대출 기록은 &lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;보존&lt;/font&gt;&lt;/b&gt; --&amp;gt; ON DELETE RESTRICT&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="595" x="105" y="240" as="geometry" />
        </mxCell>
        <mxCell id="jWkJ3WSsh8O-79yOkGr2-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;🔎 요구 사항에서 핵심 요소 추출하기&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="450" x="760" y="120" as="geometry" />
        </mxCell>
        <mxCell id="SI7xmuKSd0szvzqrLr_n-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#FF3333;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="170" width="600" x="920" y="180" as="geometry" />
        </mxCell>
        <mxCell id="SI7xmuKSd0szvzqrLr_n-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" value="&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;b style=&quot;color: rgb(255, 255, 255); font-size: 16px;&quot;&gt;규칙 &lt;/b&gt;&lt;font color=&quot;#ffffff&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;①&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;b style=&quot;color: rgb(255, 255, 255); font-size: 16px;&quot;&gt;&amp;nbsp; 명사(名詞) --&amp;gt; 엔티티(Entity) 후보&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="530" x="950" y="190" as="geometry" />
        </mxCell>
