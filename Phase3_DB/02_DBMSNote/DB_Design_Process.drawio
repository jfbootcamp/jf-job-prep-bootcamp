          <mxGeometry height="30" width="138.75" x="1690" y="450" as="geometry" />
        </mxCell>
        <mxCell id="9nzTOD2toeesHIKlp4Bj-48" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#EA6B66;dashed=1;dashPattern=8 8;strokeWidth=2;" value="&lt;font style=&quot;font-size: 19px; color: rgb(234, 107, 102);&quot;&gt;&lt;b&gt;건축에 비유하면?&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;① 요구 사항 = &quot;3층짜리 카페 겸 주택을 짖고 싶어요&quot; --&amp;gt;&amp;nbsp;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 19px;&quot;&gt;②&lt;/b&gt;&lt;span style=&quot;font-size: 19px; background-color: transparent;&quot;&gt;&amp;nbsp;개념 설계 = 대략적인 배치도 (방 몇 개, 층별 용도) --&amp;gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 19px;&quot;&gt;③&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 19px;&quot;&gt;&amp;nbsp;논리 설계 = 상세 평면도 (벽 위치, 문/창문 배치)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;④ &lt;/b&gt;물리 설계 = 자제 선정 (콘크리트? 철골?, 배관 규격) --&amp;gt;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 19px;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;⑤ &lt;/b&gt;DDL = 실제 시공 (= SQL 실행)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px; color: rgb(234, 107, 102);&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="1700" x="50" y="510" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
