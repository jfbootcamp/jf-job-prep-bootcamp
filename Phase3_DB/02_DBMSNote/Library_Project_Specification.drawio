  <diagram name="02_기능 요구사항 명세" id="D2hdDLVie0wavosIYdyo">
    <mxGraphModel dx="1678" dy="989" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="syflFumukJMQPcpSDIdv-0" />
        <mxCell id="syflFumukJMQPcpSDIdv-1" parent="syflFumukJMQPcpSDIdv-0" />
        <mxCell id="syflFumukJMQPcpSDIdv-2" parent="syflFumukJMQPcpSDIdv-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0037A4;fontColor=#ffffff;strokeColor=#001DBC;" value="" vertex="1">
          <mxGeometry height="70" width="1660" as="geometry" />
        </mxCell>
        <mxCell id="syflFumukJMQPcpSDIdv-3" parent="syflFumukJMQPcpSDIdv-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;span style=&quot;font-size: 45px;&quot;&gt;&lt;b&gt;&amp;nbsp;CHAPTER 2 - 기능 요구사항 명세 (Functional Requirements)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="1270" x="10" y="20" as="geometry" />
        </mxCell>
        <mxCell id="syflFumukJMQPcpSDIdv-4" parent="syflFumukJMQPcpSDIdv-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;font style=&quot;font-size: 20px; color: rgb(204, 204, 255);&quot;&gt;&lt;b style=&quot;&quot;&gt;온라인 도서관 시스템 SRS v1.0&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="450" x="1200" y="20" as="geometry" />
        </mxCell>
        <mxCell id="27-2T0a7DJLxjnQgvuQ8-0" parent="syflFumukJMQPcpSDIdv-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="&lt;span style=&quot;font-size: 23px;&quot;&gt;우선순위&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;color: rgb(255, 0, 0); font-size: 23px;&quot;&gt;■ P1 (Must Have)&amp;nbsp;&lt;/b&gt;&lt;b style=&quot;font-size: 23px;&quot;&gt;&lt;font style=&quot;color: rgb(180, 0, 0);&quot;&gt;■ P2 (Should Have)&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;font&gt;&lt;b style=&quot;font-size: 23px;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;■ P3 (Nice to Have)&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;color: rgb(0, 0, 255); font-size: 23px;&quot;&gt;&lt;font style=&quot;color: rgb(180, 0, 0);&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 23px;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="1070" x="80" y="90" as="geometry" />
        </mxCell>
        <mxCell id="Py0FtadVT5d8KO_n3w0i-3" parent="syflFumukJMQPcpSDIdv-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-01-1&lt;b&gt; [회원 등록] &lt;/b&gt;이름, 이메일(고유), 전화번호, 주소를 입력하여 회원을 등록한다.&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 이메일은 형식 검증 및 중복 체크 필수.&amp;nbsp; 가입일은 자동 기록&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-01-2 &lt;b&gt;[회원 조회] &lt;/b&gt;이름 또는 이메일로 회원을 검색하고 상세 정보를 조회한다.&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-01-3 &lt;b&gt;[회원 수정]&lt;/b&gt; 전화번호, 주소 등 기본 정보를 수정할 수 있다. (이메일 변경 불가)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-01-4 &lt;b&gt;[회원 삭제] &lt;/b&gt;대출 중인 도서가 없는 경우에만 회원을 비활성화 (소프트 딜리트) 한다.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="1135" x="77.5" y="177" as="geometry" />
        </mxCell>
        <mxCell id="Py0FtadVT5d8KO_n3w0i-4" parent="syflFumukJMQPcpSDIdv-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;align=left;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;FR-01 | 회원 관리 (Member Management) [ P1 - Must Have ]&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="1132.5" x="77.5" y="157" as="geometry" />
        </mxCell>
        <mxCell id="Py0FtadVT5d8KO_n3w0i-5" parent="syflFumukJMQPcpSDIdv-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-02-1&lt;b&gt; [도서 등록] &lt;/b&gt;ISBN(고유), 제목, 저자, 출판사, 출판연도, 분류, 보유수량을 등록한다.&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 보유 수량은 0 이상이어야 하며, ISBN 중복 등록은 불가하다.&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-02-2 &lt;b&gt;[도서 검색] &lt;/b&gt;제목, 저자, ISBN, 분류로 도서를 검색할수 있다.&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-02-3 &lt;b&gt;[도서 수정]&lt;/b&gt;&amp;nbsp;도서 정보 및 보유수량을&amp;nbsp; 수정할 수 있다.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-02-4 &lt;b&gt;[도서 폐기] &lt;/b&gt;대출 중인 도서를 폐기 처리(소프트 딜리트) 할수 있다.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="1135" x="80" y="380" as="geometry" />
        </mxCell>
        <mxCell id="Py0FtadVT5d8KO_n3w0i-6" parent="syflFumukJMQPcpSDIdv-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;align=left;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;FR-02 | 도서 관리 (Book Management) [ P1 - Must Have ]&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="1132.5" x="80" y="360" as="geometry" />
        </mxCell>
        <mxCell id="Py0FtadVT5d8KO_n3w0i-7" parent="syflFumukJMQPcpSDIdv-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-03-1&lt;b&gt; [대출 처리] &lt;/b&gt;회원이 도서를 대출한다. 대출일=오늘, 반납예정일=대출일+14일 자동 설정&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 조건: 재고 수량 &amp;gt;= 1, 회원의 현재 대출 수 &amp;lt;= 7권, 연체 도서 없음&lt;br&gt;&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-03-2 &lt;b&gt;[반납 처리] &lt;/b&gt;대출 중인 도서를 반납 처리한다. 실제 반납일 기록, 재고 수량 + 1&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-03-3 &lt;b&gt;[대출 현황]&lt;/b&gt;&amp;nbsp;특정 회원의 현재 대출 목록을 출력한다.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-03-4 &lt;b&gt;[연체 처리] &lt;/b&gt;반납예정일이 지난 대출 레코드의 상태를 &quot;연체&quot;로 자동 변경한다.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="1135" x="76.25" y="590" as="geometry" />
        </mxCell>
        <mxCell id="Py0FtadVT5d8KO_n3w0i-8" parent="syflFumukJMQPcpSDIdv-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;align=left;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;FR-03 | 대출/반납 (Loan Management) [ P1 - Must Have ]&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="1132.5" x="76.25" y="570" as="geometry" />
        </mxCell>
        <mxCell id="Py0FtadVT5d8KO_n3w0i-9" parent="syflFumukJMQPcpSDIdv-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-04-1&lt;b&gt; [전체 이력] &lt;/b&gt;관리자는 모든 대출/반납 이력을 날짜 기준으로 조회한다.&lt;/font&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-04-2 &lt;b&gt;[회원별 이력] &lt;/b&gt;특정 회원의 전체 대출 이력을 조회한다 (현재 대출 + 과거 반납 포함)&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-04-3 &lt;b&gt;[도서별 이력]&lt;/b&gt;&amp;nbsp;특정 도서의 대출 이력을 조회한다.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="1135" x="73.75" y="810" as="geometry" />
        </mxCell>
        <mxCell id="Py0FtadVT5d8KO_n3w0i-10" parent="syflFumukJMQPcpSDIdv-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;align=left;" value="&lt;font style=&quot;font-size: 17px; color: rgb(255, 255, 255);&quot;&gt;&lt;b style=&quot;&quot;&gt;FR-04 | 대출 이력 조회 (Loan History Management) [ P2 - Should Have ]&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="1132.5" x="73.75" y="790" as="geometry" />
        </mxCell>
        <mxCell id="Py0FtadVT5d8KO_n3w0i-11" parent="syflFumukJMQPcpSDIdv-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-05-1&lt;b&gt; [월별 대출 통계] &lt;/b&gt;월별 대출 건수 및 반납 건수 집계&lt;/font&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-05-2 &lt;b&gt;[인기 도서] &lt;/b&gt;기간별 대출 횟수 기준 TOP 10 도서 조회&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-05-3 &lt;b&gt;[연체 현황]&lt;/b&gt;&amp;nbsp;현재 연체 중인 도서 목록 및 연체일 조회&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-05-4&amp;nbsp;&lt;b&gt;[재고 현황]&lt;/b&gt;&amp;nbsp;전체 도서 보유/대출 기능 수량 요약&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="1135" x="1300" y="177" as="geometry" />
        </mxCell>
        <mxCell id="Py0FtadVT5d8KO_n3w0i-12" parent="syflFumukJMQPcpSDIdv-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;align=left;" value="&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;b style=&quot;color: rgb(255, 255, 255); font-size: 17px;&quot;&gt;FR-05 | 통계 대시보드 (&lt;/b&gt;&lt;font color=&quot;#ffffff&quot;&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;&lt;b&gt;Statistics Dashboard&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;b style=&quot;color: rgb(255, 255, 255); font-size: 17px;&quot;&gt;) [ P2 - Should Have ]&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="1132.5" x="1300" y="157" as="geometry" />
        </mxCell>
        <mxCell id="Py0FtadVT5d8KO_n3w0i-13" parent="syflFumukJMQPcpSDIdv-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;align=left;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-06-1&lt;b&gt; [예약 등록] &lt;/b&gt;현재 대출 중인 도서를 예약할 수 있다&lt;/font&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-06-2 &lt;b&gt;[예약 취소] &lt;/b&gt;회원이 본인의 예약을 취소할 수 있다&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;FR-06-3 &lt;b&gt;[예약 알림]&lt;/b&gt;&amp;nbsp;반납 완료 시 예약자에게 이메일, 문자 알림 발송&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="1135" x="1297.5" y="380" as="geometry" />
        </mxCell>
        <mxCell id="Py0FtadVT5d8KO_n3w0i-14" parent="syflFumukJMQPcpSDIdv-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;align=left;" value="&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;b style=&quot;color: rgb(255, 255, 255); font-size: 17px;&quot;&gt;FR-06 | 도서 예약 (B&lt;/b&gt;&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;&lt;b&gt;ook Reservation&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;color: rgb(255, 255, 255); font-size: 17px;&quot;&gt;) [ P3- Nice to Have ]&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;" vertex="1">
