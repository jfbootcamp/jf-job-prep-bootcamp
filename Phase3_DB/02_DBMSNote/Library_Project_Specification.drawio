  <diagram id="yQxHCHsN2koM2Ovil3eq" name="01_프로젝트 배경 &amp; 이해관계자">
    <mxGraphModel dx="815" dy="481" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="IZCw5QWp0CzGGMIEZsr2-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0037A4;fontColor=#ffffff;strokeColor=#001DBC;" value="" vertex="1">
          <mxGeometry height="70" width="1660" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;span style=&quot;font-size: 45px;&quot;&gt;&lt;b&gt;&amp;nbsp;CHAPTER 1 - 프로젝트 배경 &amp;amp; 이해관계자&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="970" x="10" y="20" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;font style=&quot;font-size: 20px; color: rgb(204, 204, 255);&quot;&gt;&lt;b style=&quot;&quot;&gt;온라인 도서관 시스템 SRS v1.0&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="450" x="1200" y="20" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;1.1 프로젝트 배경 및 목적&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="440" x="70" y="110" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;gradientColor=#7ea6e0;align=left;" value="&lt;b&gt;배경 (Background)&lt;/b&gt;&lt;div&gt;&amp;nbsp;교육청 A 도서관은 현재 수기 장부와 엑셀로 회원 가입 및 도서 대출을 관리하고 있습니다.&lt;/div&gt;&lt;div&gt;&amp;nbsp;연간 방문자 12,000명 보유 도서 80,000권 규모로 성장하면서 다음 문제가 발생하고 있습니다.&lt;/div&gt;&lt;div&gt;&amp;nbsp;* 대출 기록 조회에 평균 &lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;b&gt;10분 이상 &lt;/b&gt;&lt;/font&gt;소요 (검색 불가)&lt;/div&gt;&lt;div&gt;&amp;nbsp;* 연체 도서 파악 불가 --&amp;gt; 분실 증가&lt;/div&gt;&lt;div&gt;&amp;nbsp;* 도서 재고(보유 수량) 실시간 파악 불가&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;목적 (Objective)&lt;/b&gt;&lt;div&gt;&amp;nbsp;웹 기반 통합 도서관 관리 시스템을 구축하여 업무 효율 70% 향상 및 회원 서비스 품질 개선&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="560" x="70" y="150" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;1.2 프로젝트 범위 (Scope)&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="440" x="70" y="440" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" value="&lt;br&gt;&lt;div&gt;&lt;div&gt;* 회원 가입 / 정보 관리 (CRUD)&lt;/div&gt;&lt;/div&gt;&lt;div&gt;* 도서 등록 / 정보 관리 (CRUD)&lt;/div&gt;&lt;div&gt;* 도서 대출 / 반납 처리&lt;/div&gt;&lt;div&gt;* 대출 현황 조회 (개인 / 관리자)&lt;/div&gt;&lt;div&gt;* 연체 도서 현황 파악&lt;/div&gt;&lt;div&gt;* 도서 재고 수량 관리&lt;/div&gt;&lt;div&gt;* 관리자 통계 대시보드&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="270" x="70" y="480" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#60a917;fontColor=#ffffff;strokeColor=#2D7600;" value="&lt;b&gt;✅포함 (IN Scope)&amp;nbsp;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="255" x="75" y="480" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;align=left;" value="&lt;br&gt;&lt;div&gt;&lt;div&gt;* 전자책 / 오디오북 서비스&lt;/div&gt;&lt;/div&gt;&lt;div&gt;* 온라인 결재 (연체료 등)&lt;/div&gt;&lt;div&gt;* 외부 도서관 연계 API&lt;/div&gt;&lt;div&gt;* 모바일 앱 (1차 개발 제외)&lt;/div&gt;&lt;div&gt;* 도서 추천 AI 기능&lt;/div&gt;&lt;div&gt;&amp;nbsp; --&amp;gt; (Phase 2에서 검토 예정)&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="270" x="350" y="480" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d80073;fontColor=#ffffff;strokeColor=#A50040;" value="&lt;b&gt;❌제외 (OUT of Scope)&amp;nbsp;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="255" x="355" y="480" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;1.3 이해관계자 (Stakeholders)&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="440" x="700" y="100" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;align=left;" value="&lt;br&gt;&lt;div&gt;&lt;div&gt;* 👤&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;역할 : 시스템의 핵심 사용자&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;니즈:&amp;nbsp; 빠른 도서 검색,&amp;nbsp; 간편한 대출/반납,&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 개인 대출 현황 조회&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;기대: 직관적인 UI, 3초 이내 응답&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="270" x="695" y="150" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fa6800;strokeColor=#C73500;fontColor=#000000;" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;도서관 회원(일반 사용자)&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="255" x="700" y="150" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;align=left;" value="&lt;br&gt;&lt;div&gt;&lt;div&gt;* 🤹🏼&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;역할 : 시스템의 운영 및 데이터 관리&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;니즈:&amp;nbsp; 회원 도서 관리, 대출/반납 처리, 통계 조회&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;기대: 기존 엑셀 대비 업무 효율 향상&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="270" x="1000" y="150" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;fontColor=#ffffff;" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;도서관 사서 (관리자)&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="255" x="1005" y="150" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;gradientColor=#97d077;" value="&lt;br&gt;&lt;div&gt;&lt;div&gt;* 🏛️&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;역할 : 예산 승인, 최종 검수&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;니즈:&amp;nbsp; 도서관 운영 현황 대시보드, 비용 절감&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;기대: ROI (투자 대비 효율) 측정 가능한 시스템&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="270" x="692.5" y="310" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#008a00;strokeColor=#005700;fontColor=#ffffff;" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;도서관장(의사 결정자 / 발주자)&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="255" x="697.5" y="310" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;align=left;" value="&lt;br&gt;&lt;div&gt;&lt;div&gt;* 🖥️&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;역할 : 설계, 개발, 테스트&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;니즈:&amp;nbsp; 명확한 요구사항, 우선순위 지침&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;기대: 변경 최소화된 확정 명세서&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="270" x="997.5" y="310" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6a00ff;strokeColor=#3700CC;fontColor=#ffffff;" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;개발팀(시스템 구현자)&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="255" x="1002.5" y="310" as="geometry" />
