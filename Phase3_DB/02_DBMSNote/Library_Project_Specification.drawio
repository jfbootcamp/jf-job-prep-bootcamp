        <mxCell id="hT2PrA5A_NPWoq05b6bM-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;1.4 용어 정의 (Glossary)&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="440" x="690" y="440" as="geometry" />
