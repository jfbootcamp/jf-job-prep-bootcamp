        <mxCell id="hT2PrA5A_NPWoq05b6bM-21" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;" value="&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;용어 | 정의&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="570" x="700" y="470" as="geometry" />
