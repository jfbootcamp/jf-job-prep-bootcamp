        <mxCell id="hT2PrA5A_NPWoq05b6bM-24" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;align=left;strokeColor=#36393d;" value="&lt;b&gt;대출 (Loan) |&amp;nbsp; &amp;nbsp;&lt;/b&gt;회원이 도서를 빌리는 행위. 기간 최대 14일" vertex="1">
          <mxGeometry height="30" width="570" x="700" y="560" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-25" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;align=left;" value="&lt;b&gt;연체 (Overdue) |&amp;nbsp; &amp;nbsp;&lt;/b&gt;반납예정일을 초과했으나 아직 반납하지 않은 상태" vertex="1">
          <mxGeometry height="30" width="570" x="700" y="590" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-26" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;align=left;strokeColor=#36393d;" value="&lt;b&gt;재고 (Stock) |&amp;nbsp; &amp;nbsp;&lt;/b&gt;도서의 보유 수량 중 현재 대출 가능한 권수" vertex="1">
          <mxGeometry height="30" width="570" x="700" y="620" as="geometry" />
