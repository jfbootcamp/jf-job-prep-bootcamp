        <mxCell id="hT2PrA5A_NPWoq05b6bM-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;1.5 개발 일정 (Milestones)&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="440" x="60" y="690" as="geometry" />
        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-28" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;" value="&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;마일스톤 | 목표 일자 | 주요 내용&lt;/b&gt;&lt;/font&gt;" vertex="1">
