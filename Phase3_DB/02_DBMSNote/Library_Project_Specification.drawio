        </mxCell>
        <mxCell id="hT2PrA5A_NPWoq05b6bM-23" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;align=left;" value="&lt;b&gt;도서 (Book) |&amp;nbsp; &amp;nbsp;&lt;/b&gt;도서관이 보유한 물리적 서적. ISBN으로 고유 식별" vertex="1">
